&GLOBAL
  PROJECT MoS2_Pristine
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS

    &MGRID
      CUTOFF 240
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

    &PRINT

      &MO
        EIGENVALUES
      &END MO

    &END PRINT

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &COORD
Mo   1.59612   0.92152   3.34457
 S   0.00000   1.84304   4.90874
 S   0.00000   1.84304   1.78041
Mo   0.00000   3.68608   3.34457
 S  -1.59612   4.60760   4.90874
 S  -1.59612   4.60760   1.78041
Mo   4.78836   0.92152   3.34457
 S   3.19224   1.84304   4.90874
 S   3.19224   1.84304   1.78041
Mo   3.19224   3.68608   3.34457
 S   1.59612   4.60760   4.90874
 S   1.59612   4.60760   1.78041

    &END COORD

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
  &END GEO_OPT

  &PRINT

    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY

    &RESTART
      BACKUP_COPIES 3
    &END RESTART

  &END PRINT

&END MOTION
