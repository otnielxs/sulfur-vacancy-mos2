&GLOBAL
  PROJECT MoS2_Pristine
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS

    &MGRID
      CUTOFF 240
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      ADDED_MOS 50
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

    &PRINT

      &MO
        EIGENVALUES
      &END MO
      
      &DOS
      &END DOS
      &BAND_STRUCTURE

        FILE_NAME MoS2_bs

        &KPOINT_SET

          UNITS B_VECTOR

          SPECIAL_POINT 0.000 0.000 0.000   # Gamma
          SPECIAL_POINT 0.500 0.000 0.000   # M
          SPECIAL_POINT 0.333 0.333 0.000   # K
          SPECIAL_POINT 0.000 0.000 0.000   # Gamma

          NPOINTS 20

        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &COORD
 Mo         1.5962113438        0.9214672485        3.3451398704
  S         0.0001096213        1.8429767888        4.9070991134
  S         0.0001094536        1.8429768721        1.7825842808
 Mo         0.0000913460        3.6860272885        3.3451398708
  S        -1.5960103788        4.6075366937        4.9070990859
  S        -1.5960105329        4.6075367938        1.7825842917
 Mo         4.7884514646        0.9214673181        3.3451398561
  S         3.1923495190        1.8429766934        4.9070991155
  S         3.1923493373        1.8429768112        1.7825842592
 Mo         3.1923314443        3.6860273307        3.3451398521
  S         1.5962295442        4.6075366184        4.9070990748
  S         1.5962293658        4.6075367551        1.7825842914
    &END COORD

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
  &END GEO_OPT

  &PRINT

    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY

    &RESTART
      BACKUP_COPIES 3
    &END RESTART

  &END PRINT

&END MOTION
