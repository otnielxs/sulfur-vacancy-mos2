&GLOBAL
  PROJECT MoS2_H2O
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS

    &MGRID
      CUTOFF 240
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      ADDED_MOS 50
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

    &PRINT
      &DOS
      &END DOS
      &BAND_STRUCTURE

        FILE_NAME MoS2_H2O_bs

        &KPOINT_SET

          UNITS B_VECTOR

          SPECIAL_POINT 0.000 0.000 0.000   # Gamma
          SPECIAL_POINT 0.500 0.000 0.000   # M
          SPECIAL_POINT 0.333 0.333 0.000   # K
          SPECIAL_POINT 0.000 0.000 0.000   # Gamma

          NPOINTS 20

        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &COORD
 Mo         1.7591605237        1.0281412741        3.3081373863
  S         0.0207065342        1.9648295924        4.7592193256
  S         0.2047323935        1.8992966562        1.6507141912
 Mo         0.1251811779        3.7741632320        3.1746610133
  S        -1.4956294665        4.5878713934        4.7553707849
  S        -1.4532683201        4.7815018262        1.6448757618
 Mo         4.9354949475        1.0467804510        3.1233529497
  S         3.3069294923        1.9224261844        1.6563268997
 Mo         3.3625628783        3.7786611445        3.1134725095
  S         1.7445939056        4.7084978191        4.6785081641
  S         1.7325635787        4.7081704762        1.5753902693
  O         2.8210937739        1.5642764461        5.4668469305
  H         3.4389153629        2.3204895287        5.3193006417
  H         2.1161165184        1.8823172887        6.0696420398
    &END COORD

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q1
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
  &END GEO_OPT

  &PRINT

    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY

    &RESTART
    &END RESTART

  &END PRINT

&END MOTION
