&GLOBAL
  PROJECT MoS2_Vaccancy
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS

    &MGRID
      CUTOFF 240
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      ADDED_MOS 50
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

    &PRINT

      &MO
        EIGENVALUES
      &END MO
      
      &DOS
      &END DOS
      &BAND_STRUCTURE

        FILE_NAME MoS2_v_bs

        &KPOINT_SET

          UNITS B_VECTOR

          SPECIAL_POINT 0.000 0.000 0.000   # Gamma
          SPECIAL_POINT 0.500 0.000 0.000   # M
          SPECIAL_POINT 0.333 0.333 0.000   # K
          SPECIAL_POINT 0.000 0.000 0.000   # Gamma

          NPOINTS 20

        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &COORD
 Mo         1.6151334812        0.9321460671        3.3453389944
  S         0.0003590036        1.8561017800        4.8999835317
  S         0.0001560292        1.8088544983        1.7877066971
 Mo         0.0007269701        3.6856625154        3.3392652573
  S        -1.5838190168        4.6005016790        4.9000736448
  S        -1.6246113673        4.6240536524        1.7876180200
 Mo         4.7697450354        0.9322700736        3.3454602281
  S         3.1923576578        1.8429754683        1.8078919486
 Mo         3.1925466915        3.6643066506        3.3453378690
  S         1.5849883432        4.6007622808        4.8999813871
  S         1.6258035428        4.6245616814        1.7877047630
    &END COORD

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
  &END GEO_OPT

  &PRINT

    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY

    &RESTART
      BACKUP_COPIES 3
    &END RESTART

  &END PRINT

&END MOTION
