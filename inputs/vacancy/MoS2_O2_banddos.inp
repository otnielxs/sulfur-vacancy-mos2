&GLOBAL
  PROJECT MoS2_O2
  RUN_TYPE ENERGY
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 4 4 1
    &END KPOINTS

    &MGRID
      CUTOFF 240
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 300
      ADDED_MOS 50
      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

    &PRINT

      &DOS
      &END DOS
      &BAND_STRUCTURE

        FILE_NAME MoS2_O2_bs

        &KPOINT_SET

          UNITS B_VECTOR

          SPECIAL_POINT 0.000 0.000 0.000   # Gamma
          SPECIAL_POINT 0.500 0.000 0.000   # M
          SPECIAL_POINT 0.333 0.333 0.000   # K
          SPECIAL_POINT 0.000 0.000 0.000   # Gamma

          NPOINTS 20

        &END KPOINT_SET

      &END BAND_STRUCTURE
    &END PRINT

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &COORD
 Mo         1.3948059052        1.1111054524        3.4038416894
  S        -0.2100844465        2.0225824039        4.9779105566
  S        -0.2100143098        2.0122048544        1.8540644653
 Mo        -0.2095465365        3.8709034587        3.4188356673
  S        -1.8105384172        4.7946867854        4.9779115885
  S        -1.8194026200        4.7998477885        1.8541237600
 Mo         4.5691766354        1.1115960044        3.4037572865
  S         2.9819430723        2.0277794845        1.8420061800
 Mo         2.9822593915        3.8603833759        3.4039385177
  S         1.3909633384        4.7953926297        4.9779623627
  S         1.4001500451        4.8005394042        1.8540714468
  O         2.9793647903        2.0272910562        5.9943162630
  O         2.9800641158        2.0274497859        4.6321990983
    &END COORD

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

&END FORCE_EVAL

&MOTION

  &GEO_OPT
    OPTIMIZER BFGS
    MAX_ITER 200
  &END GEO_OPT

  &PRINT

    &TRAJECTORY
      FORMAT XYZ
    &END TRAJECTORY

    &RESTART
    &END RESTART

  &END PRINT

&END MOTION
