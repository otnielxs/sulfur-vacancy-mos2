&GLOBAL
  PROJECT MoS2_O2_NEB
  RUN_TYPE BAND
  PRINT_LEVEL MEDIUM
&END GLOBAL

&EXT_RESTART
  RESTART_FILE_NAME MoS2_O2_NEB-1.restart
  RESTART_DEFAULT T
&END EXT_RESTART

&FORCE_EVAL
  METHOD Quickstep

  &DFT

    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS

    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 1
    &END KPOINTS

    &MGRID
      CUTOFF 200
      REL_CUTOFF 30
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-5
      MAX_SCF 150

      ADDED_MOS 30

      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.05
        NBUFFER 8
      &END MIXING

    &END SCF

    &XC

      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL

        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
        &END PAIR_POTENTIAL

      &END VDW_POTENTIAL

    &END XC

  &END DFT

  &SUBSYS

    &CELL
      A  6.38448   0.00000   0.00000
      B -3.19224   5.52912   0.00000
      C  0.00000   0.00000  12.37829
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME image1.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND Mo
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q14
    &END KIND

    &KIND S
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

    &KIND O
      BASIS_SET DZVP-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q6
    &END KIND

  &END SUBSYS

&END FORCE_EVAL


&MOTION

  &CONSTRAINT
    &FIXED_ATOMS
      LIST 3 6 8 11
    &END FIXED_ATOMS
  &END CONSTRAINT

  &BAND

    BAND_TYPE CI-NEB

    NUMBER_OF_REPLICA 5

    K_SPRING 0.02

    ALIGN_FRAMES T
    ROTATE_FRAMES F

    &CONVERGENCE_CONTROL
      MAX_FORCE 2.0E-3
      RMS_FORCE 1.0E-3
    &END CONVERGENCE_CONTROL

    &OPTIMIZE_BAND
      OPT_TYPE DIIS
    &END OPTIMIZE_BAND

    &CI_NEB
    &END CI_NEB

    &REPLICA
      COORD_FILE_NAME image1.xyz
    &END REPLICA

    &REPLICA
      COORD_FILE_NAME image2.xyz
    &END REPLICA

    &REPLICA
      COORD_FILE_NAME image3.xyz
    &END REPLICA

    &REPLICA
      COORD_FILE_NAME image4.xyz
    &END REPLICA

    &REPLICA
      COORD_FILE_NAME image5.xyz
    &END REPLICA

  &END BAND

&END MOTION
